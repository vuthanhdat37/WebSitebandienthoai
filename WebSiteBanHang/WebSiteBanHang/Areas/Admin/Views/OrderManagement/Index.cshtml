@model IEnumerable<WebSiteBanHang.Models.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/admin.css" />

<div class="container mt-4">
    <div class="card shadow-sm admin-card">
        <div class="card-header">
            <h4 class="mb-0"><i class="fas fa-list-ul me-2"></i>Quản lý đơn hàng</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-custom mb-0">
                    <thead>
                        <tr>
                            <th scope="col">ID Đơn hàng</th>
                            <th scope="col">Tên Khách hàng</th>
                            <th scope="col">Ngày Đặt</th>
                            <th scope="col">Tổng tiền</th>
                            <th scope="col" class="text-center">Trạng thái</th>
                            <th scope="col" class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            var statusClass = "status-default";
                            if (order.OrderStatus == "Chờ xác nhận") { statusClass = "status-pending"; }
                            else if (order.OrderStatus == "Đã xác nhận") { statusClass = "status-confirmed"; }
                            else if (order.OrderStatus == "Đã thanh toán") { statusClass = "status-paid"; }
                            else if (order.OrderStatus == "Đã hủy") { statusClass = "status-cancelled"; }

                            <tr>
                                <td class="font-weight-bold">#@order.Id</td>
                                <td>@order.ApplicationUser.FullName</td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@order.TotalPrice.ToString("N0") VNĐ</td>
                                <td class="text-center">
                                    <span class="status-badge @statusClass">@order.OrderStatus</span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-action btn-primary" title="Xem và sửa chi tiết">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    @if (order.OrderStatus == "Chờ xác nhận")
                                    {
                                        <form asp-action="Reject" asp-route-id="@order.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn từ chối đơn hàng này không?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-action btn-danger" title="Từ chối nhanh">
                                                <i class="fas fa-times-circle"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div> 