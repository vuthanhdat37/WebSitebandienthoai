@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container my-5 manage-account-container">
    <div class="row">
        <div class="col-lg-3">
            <partial name="_ManageNav" />
        </div>
        <div class="col-lg-9">
            <div class="manage-content-wrapper">
                @RenderBody()
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}

@section Styles {
<style>
    :root {
        --primary-color: #007bff;
        --primary-hover-color: #0056b3;
        --secondary-text-color: #6c757d;
        --card-bg-color: #ffffff;
        --body-bg-color: #f4f6f9;
        --border-color: #e9ecef;
        --card-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
    }

    body {
        background-color: var(--body-bg-color);
    }
    
    .manage-content-wrapper {
        background-color: var(--card-bg-color);
        padding: 2rem;
        border-radius: 12px;
        box-shadow: var(--card-shadow);
        min-height: 100%;
    }

    /* General Form/Element Styling for Manage Pages */
    .manage-page-title {
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .manage-page-subtitle {
        color: var(--secondary-text-color);
        margin-bottom: 1.5rem;
        font-size: 1rem;
    }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: var(--primary-color);
    }

    .btn-primary {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
        padding: 0.75rem 1.5rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }
    .btn-primary:hover {
        background-color: var(--primary-hover-color);
        border-color: var(--primary-hover-color);
        transform: translateY(-2px);
    }

    /* Styles for the navigation menu (_ManageNav) */
    .nav-pills .nav-link {
        color: #343a40;
        font-weight: 500;
        padding: 0.8rem 1.2rem;
        border-radius: 8px;
        margin-bottom: 0.5rem;
        transition: all 0.2s ease-in-out;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .nav-pills .nav-link i {
        font-size: 1.1rem;
        width: 20px;
        text-align: center;
        color: var(--secondary-text-color);
        transition: color 0.2s ease-in-out;
    }
    
    .nav-pills .nav-link:hover {
        background-color: #e9ecef;
        color: var(--primary-color);
    }

     .nav-pills .nav-link:hover i {
        color: var(--primary-color);
    }

    .nav-pills .nav-link.active, .nav-pills .show > .nav-link {
        background-color: var(--primary-color);
        color: white;
        box-shadow: 0 4px 10px rgba(0, 123, 255, 0.3);
    }
    .nav-pills .nav-link.active i {
        color: white;
    }
    
</style>
}