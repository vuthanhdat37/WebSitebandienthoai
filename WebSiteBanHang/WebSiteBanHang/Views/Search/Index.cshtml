@model WebSiteBanHang.ViewModels.SearchViewModel

@{
    ViewData["Title"] = $"Kết quả tìm kiếm cho '{Model.Query}'";
}

<div class="container mt-4">
    <h1 class="page-title mb-4">@ViewData["Title"]</h1>

    @if (Model.Results != null && Model.Results.Any())
    {
        <div class="row product-grid row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
            @foreach (var product in Model.Results)
            {
                <div class="col">
                    <div class="card product-card-custom h-100">
                        <a asp-action="Details" asp-controller="Product" asp-route-id="@product.Id" class="product-card-link">
                            <div class="product-image-container">
                                <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/placeholder.png" : Url.Content(product.ImageUrl))"
                                     class="product-image" alt="@product.Name">
                            </div>
                        </a>
                        <div class="card-body d-flex flex-column">
                            <h5 class="product-title">
                                <a asp-action="Details" asp-controller="Product" asp-route-id="@product.Id">@product.Name</a>
                            </h5>
                            <p class="product-price">@product.Price.ToString("N0") đ</p>
                            <div class="mt-auto">
                                <a asp-controller="ShoppingCart" asp-action="AddToCart" asp-route-productId="@product.Id" class="btn btn-primary-custom w-100">
                                    <i class="fas fa-cart-plus"></i> Thêm vào giỏ
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-5">
                <ul class="pagination justify-content-center">
                    @if (Model.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-query="@Model.Query" asp-route-page="@(Model.PageNumber - 1)">Previous</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Previous</a>
                        </li>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-query="@Model.Query" asp-route-page="@i">@i</a>
                        </li>
                    }

                    @if (Model.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-query="@Model.Query" asp-route-page="@(Model.PageNumber + 1)">Next</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <a class="page-link" href="#">Next</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="text-center mt-5">
            <i class="fas fa-search fa-3x text-muted mb-3"></i>
            <h4>Không tìm thấy sản phẩm nào</h4>
            <p class="text-muted">Vui lòng thử lại với một từ khóa khác.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Quay về trang chủ</a>
        </div>
    }
</div> 