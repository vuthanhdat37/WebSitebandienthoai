@model IEnumerable<WebSiteBanHang.Models.Order>

@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

@section Styles {
    <style>
        :root {
            --primary-color: #0056b3;
            --success-color: #198754;
            --warning-color: #ffc107;
            --danger-color: #dc3545;
            --info-color: #0dcaf0;
            --secondary-color: #6c757d;
            --border-color: #dee2e6;
            --card-bg: #ffffff;
            --card-shadow: 0 4px 25px rgba(0, 0, 0, 0.05);
        }

        .status-badge {
            padding: 0.4em 0.8em;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #fff;
        }

        .status-pending { background-color: var(--warning-color); color:#212529; }
        .status-confirmed { background-color: var(--primary-color); }
        .status-shipping { background-color: var(--info-color); }
        .status-delivered { background-color: var(--success-color); }
        .status-paid { background-color: var(--success-color); }
        .status-cancelled { background-color: var(--danger-color); }
        .status-rejected { background-color: var(--danger-color); }

        .order-card {
            background-color: var(--card-bg);
            border-radius: 12px;
            border: 1px solid var(--border-color);
            box-shadow: var(--card-shadow);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .order-card:hover {
             transform: translateY(-5px);
             box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        }

        .order-card .card-header {
            background-color: transparent;
            border-bottom: 1px solid #f0f2f5;
        }
        .order-card .card-footer {
             background-color: transparent;
        }
        .product-item-row {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid #f0f2f5;
        }
        .product-item-row:last-child {
            border-bottom: none;
        }

        .product-image-condensed {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 6px;
            margin-right: 15px;
            flex-shrink: 0;
        }

        .product-name-condensed {
            font-weight: 500;
        }
    </style>
}

<div class="container my-5">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    @if (TempData["PaymentMessage"] != null)
    {
        <div class="alert alert-info" role="alert">
            @TempData["PaymentMessage"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        @foreach (var order in Model)
        {
            <div class="card order-card mb-4">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1 font-weight-bold">Đơn hàng #@order.Id</h5>
                        <small class="text-muted">Ngày đặt: @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                    @{
                        var statusClass = "status-secondary";
                        if (order.OrderStatus == "Chờ xác nhận") { statusClass = "status-pending"; }
                        else if (order.OrderStatus == "Đã xác nhận") { statusClass = "status-confirmed"; }
                        else if (order.OrderStatus == "Đang giao hàng") { statusClass = "status-shipping"; }
                        else if (order.OrderStatus == "Đã giao hàng") { statusClass = "status-delivered"; }
                        else if (order.OrderStatus == "Đã thanh toán") { statusClass = "status-paid"; }
                        else if (order.OrderStatus == "Đã từ chối") { statusClass = "status-rejected"; }
                        else if (order.OrderStatus == "Đã hủy") { statusClass = "status-cancelled"; }
                    }
                    <div>
                        <span class="status-badge @statusClass">@order.OrderStatus</span>
                    </div>
                </div>
                <div class="card-body p-0">
                    @foreach (var detail in order.OrderDetails)
                    {
                        <div class="product-item-row d-flex justify-content-between align-items-center">
                            <div class="product-info-condensed">
                                <img src="@(detail.Product.ImageUrl ?? "/images/placeholder.png")" alt="@detail.Product.Name" class="product-image-condensed">
                                <span class="product-name-condensed">
                                    @detail.Product.Name (x @detail.Quantity)
                                </span>
                            </div>
                            <div class="price-condensed">
                                @((detail.Price * detail.Quantity).ToString("N0")) VNĐ
                            </div>
                        </div>
                    }
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <strong style="font-size: 1.1rem;">Tổng cộng: @order.TotalPrice.ToString("N0") VNĐ</strong>
                    <a asp-action="OrderDetail" asp-route-id="@order.Id" class="btn btn-outline-primary">
                        Xem Chi Tiết <i class="fas fa-chevron-right ms-2"></i>
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
            <div class="card shadow-sm p-5" style="border-radius: 18px; background: #fff; min-width: 420px;">
                <div class="text-center mb-4">
                    <i class="fas fa-box-open" style="font-size: 4rem; color: var(--primary-color);"></i>
                </div>
                <h2 class="text-center mb-3" style="color: #343a40; font-weight: 700;">Bạn chưa có đơn hàng nào</h2>
                <p class="text-center mb-4" style="color: #6c757d;">Hãy khám phá các sản phẩm công nghệ mới nhất và đặt hàng ngay hôm nay!</p>
                <div class="text-center">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4 py-2" style="font-size: 1.1rem; font-weight: 500; border-radius: 24px;">
                        <i class="fas fa-shopping-cart me-2"></i> Bắt đầu mua sắm
                    </a>
                </div>
            </div>
        </div>
    }
</div> 