@model WebSiteBanHang.Models.Product

@{
    ViewData["Title"] = Model.Name;
    var baseImageUrl = "/images/"; // Assuming your images are in wwwroot/images
    var placeholderImageUrl = baseImageUrl + "placeholder.png"; // Define a placeholder
}

<div class="product-display-container">
    <div class="row">
        <div class="col-md-6 text-center mb-3 mb-md-0">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? placeholderImageUrl : Url.Content(Model.ImageUrl))"
                 alt="@Model.Name"
                 class="img-fluid product-display-image shadow-sm">
        </div>
        <div class="col-md-6 product-info">
            <h2 class="product-display-title">@Model.Name</h2>
            <p class="product-display-price">@Model.Price.ToString("N0") đ</p>
            <p class="product-display-description">@Model.Description</p>

            <div class="product-actions mt-4">
                <a asp-action="Index" asp-controller="Product" class="btn btn-theme-custom me-2">
                    <i class="fas fa-arrow-left"></i> Quay lại Danh Sách
                </a>
                @* Add to cart button can be added here if functionality exists *@
                @* <a href="#" class="btn btn-success"><i class="fas fa-cart-plus"></i> Thêm vào giỏ hàng</a> *@
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --theme-color-yellow-bg: #FFFACD; /* LemonChiffon - used for main product display background */
            --theme-color-yellow-light: #FFF5E1; /* Lighter yellow for subtle accents if needed */
            --theme-color-brown-dark: #8B4513; /* SaddleBrown */
            --theme-color-brown-medium: #A0522D; /* Sienna */
            --theme-color-gold: #FFD700;
            --theme-color-ivory: #FFFFF0; /* For card-like backgrounds or contrasting elements */
            --theme-color-price: #B22222; /* Firebrick - A strong red for price */
            --text-color-dark: #5D4037; /* General text */
        }

        .product-display-container {
            background-color: var(--theme-color-yellow-bg);
            padding: 30px;
            border-radius: 12px;
            margin-top: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .product-display-image {
            max-height: 450px;
            width: auto;
            object-fit: contain; /* Changed from cover to contain for better visibility of whole product */
            border-radius: 8px;
            border: 3px solid var(--theme-color-ivory);
        }

        .product-info {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .product-display-title {
            font-family: 'Satisfy', cursive; /* Using the bakery name font for product title */
            color: var(--theme-color-brown-dark);
            font-size: 2.8rem; /* Prominent title */
            margin-bottom: 15px;
        }

        .product-display-price {
            color: var(--theme-color-price);
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .product-display-description {
            color: var(--text-color-dark);
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .btn-theme-custom {
            background-color: var(--theme-color-gold);
            border-color: var(--theme-color-gold);
            color: var(--theme-color-brown-dark);
            font-weight: 500;
            padding: 10px 20px;
            transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
        }

        .btn-theme-custom:hover {
            background-color: #E6C200; /* Vàng đậm hơn khi hover */
            border-color: #E6C200;
            color: var(--theme-color-brown-dark);
            transform: translateY(-2px);
        }
        .btn-theme-custom .fas {
            margin-right: 8px;
            color: var(--theme-color-brown-dark);
        }

        /* Responsive adjustments */
        @@media (max-width: 767px) {
            .product-display-title {
                font-size: 2.2rem;
            }
            .product-display-price {
                font-size: 1.6rem;
            }
            .product-info {
                text-align: center; /* Center text on smaller screens */
            }
            .product-display-image {
                max-height: 300px;
            }
            .product-actions .btn {
                width: 100%;
                margin-bottom: 10px;
            }
             .product-actions .btn:last-child {
                margin-bottom: 0;
            }
        }
    </style>
}
